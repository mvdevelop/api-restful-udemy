{
  "name": "api-restful-udemy",
  "version": "1.0.0",
  "description": "API RESTful completa com CRUD, autenticação JWT e gestão de alunos",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "dev": "nodemon src/server.js",
    "build": "sucrase ./src -d ./dist --transforms imports",
    "start": "node dist/server.js"
  },
  "keywords": [
    "api",
    "restful",
    "nodejs",
    "express",
    "jwt",
    "sequelize",
    "mariadb",
    "typescript",
    "crud"
  ],
  "author": "mvdevelop",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.0.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.9.6",
    "sequelize-cli": "^6.6.2",
    "sucrase": "^3.35.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mariadb": "^3.4.0",
    "multer": "^1.4.5-lts.1",
    "sequelize": "^6.37.5"
  }
}
